#!/usr/bin/env bash
# Run the API benchmark. See benchmark/README.md.
#   bin/bench load [--contenders a,b] [--scenarios list-20,list-100,item] [--vus 8]   k6 load test (use bin/env prod first)
#   bin/bench features                                                              feature checks against the running APIs and the database
#   bin/bench profile                                                               T3Flare profile per API (dev mode)
#   bin/bench footprint                                                             configuration needed per API
#   bin/bench site                                                                  build docs/index.html from the results
#   bin/bench talk                                                                  build docs/talk/index.html from talk/
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
command="${1:-}"
shift || true

case "$command" in
    load) exec bun "$root/benchmark/run.ts" "$@" ;;
    features | profile | footprint | site | talk) exec bun "$root/benchmark/$command.ts" "$@" ;;
    *)
        sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac
