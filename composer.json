{
	"name": "maikschneider/t3cb26-demo",
	"description": "Demo project for the tca_api talk at TYPO3 Camp Berlin 2026",
	"license": "GPL-2.0-or-later",
	"type": "project",
	"require": {
		"php": "^8.4",
		"maikschneider/camp-demo": "@dev",
		"maikschneider/camp-extbase": "@dev",
		"maikschneider/camp-recordapi": "@dev",
		"maikschneider/camp-sgapicore": "@dev",
		"maikschneider/camp-t3api": "@dev",
		"maikschneider/camp-tcaapi": "@dev",
		"sourcebroker/t3api": "dev-release/5.0.0#4b96399f0cae3a3afed821e77b5e677781be3c6b",
		"typo3/cms-backend": "^14.3",
		"typo3/cms-core": "^14.3",
		"typo3/cms-extbase": "^14.3",
		"typo3/cms-fluid": "^14.3",
		"typo3/cms-frontend": "^14.3",
		"typo3/cms-install": "^14.3"
	},
	"repositories": [
		{
			"name": "t3flare",
			"type": "vcs",
			"url": "git@github.com:maikschneider/t3flare.git"
		},
		{
			"type": "path",
			"url": "packages/*"
		}
	],
	"minimum-stability": "stable",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"sort-packages": true
	},
	"extra": {
		"typo3/cms": {
			"web-dir": "public"
		}
	},
	"require-dev": {
		"maikschneider/t3flare": "dev-main"
	}
}
